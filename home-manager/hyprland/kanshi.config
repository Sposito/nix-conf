# Docked: Philips on the left, laptop on the right
profile docked {
    output HDMI-A-2 enable
    output eDP-1 enable scale 2 position 1920,0
}

# Undocked: laptop only
profile undocked {
    output eDP-1 enable scale 2 position 0,0
}

# External only
profile external_only {
    output eDP-1 disable
    output HDMI-A-2 enable
}
